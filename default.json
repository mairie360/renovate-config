{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Paris",
  "schedule": ["at any time"],
  "labels": ["dependencies"],
  "platformAutomerge": true,
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Éviter l'automerge sur les versions 0.x par défaut",
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "description": "GitHub Actions : Utiliser uniquement SemVer (pas de SHA) et Automerge",
      "matchManagers": ["github-actions"],
      "pinDigests": false, 
      "automerge": true
    },
    {
      "description": "Groupement & Automerge Rust (Minor/Patch)",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "rust dependencies",
      "automerge": true
    },
    {
      "description": "Groupement & Automerge TypeScript (Minor/Patch)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "typescript dependencies",
      "automerge": true
    },
    {
      "description": "Force le registre GitHub pour les packages @mairie360",
      "matchPackagePatterns": ["^@mairie360/"],
      "registryUrls": ["https://npm.pkg.github.com"],
      "groupName": "mairie360 internal",
      "automerge": true
    },
    {
      "description": "Automerge TOTAL (Majors incluses) pour le dev local",
      "matchFileNames": ["development.Dockerfile", "docker-compose.yml"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Protection stricte du Dockerfile de production",
      "matchFileNames": ["Dockerfile"],
      "automerge": false
    },
    {
      "description": "The database and liquibase-migrations images are released with the same tag: bump them together in one PR",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/mairie360/database",
        "ghcr.io/mairie360/liquibase-migrations"
      ],
      "groupName": "mairie360 database schema"
    }
  ],
  "customManagers": [
    {
      "description": "Track pins annotated with `# renovate: datasource=<ds> depName=<name>` on the line above (e.g. TEST_DB_VERSION in .cargo/config.toml)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.cargo/config\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+\\w+ = \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "hostRules": [
    {
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm",
      "token": "{{secrets.MEND_RENOVATE_PACKAGE_TOKEN}}"
    }
  ]
}